<UserControl x:Class="CryptoMail.Views.SenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="20">
            <TextBlock Text="Параметры отправки" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>
            
            <TextBlock Text="Email получателя:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding RecipientEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="8"/>

            <TextBlock Text="Тема письма:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="8"/>

            <TextBlock Text="Файл для защиты:" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SelectedFilePath}" IsReadOnly="True" Padding="8" Background="#F9F9F9"/>
                <Button Grid.Column="1" Content="Обзор..." Command="{Binding ChooseFileCommand}" Margin="10,0,0,0" Style="{StaticResource ModernButtonStyle}"/>
            </Grid>

            <Button Content="ПОДПИСАТЬ, ЗАШИФРОВАТЬ И ОТПРАВИТЬ" 
                    Command="{Binding SendCommand}" 
                    Height="50" Style="{StaticResource ActionButtonStyle}"/>
            
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Margin="0,15,0,0" FontWeight="SemiBold" Foreground="#2980B9" FontSize="14"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="20">
            <StackPanel>
                <TextBlock Text="Настройки почты (SMTP)" FontWeight="Bold" Margin="0,0,0,15" FontSize="14"/>
                
                <TextBlock Text="Ваш Email (Логин):" FontSize="11" Foreground="#7F8C8D"/>
                <TextBox Text="{Binding Settings.Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" Padding="5"/>

                <TextBlock Text="Пароль приложения:" FontSize="11" Foreground="#7F8C8D"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SenderPasswordBox" Padding="5" PasswordChanged="SenderPasswordBox_OnPasswordChanged"/>
                    <TextBox x:Name="SenderPasswordReveal" Padding="5" Visibility="Collapsed" Text="{Binding Settings.Password, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="👁" Width="30" Margin="5,0,0,0" 
                            PreviewMouseDown="PasswordReveal_MouseDown" 
                            PreviewMouseUp="PasswordReveal_MouseUp"
                            Style="{StaticResource GhostButtonStyle}" Padding="0"/>
                </Grid>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="SMTP Хост:" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding Settings.SmtpHost}" Margin="0,2,0,10" Padding="5"/>
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Порт:" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding Settings.SmtpPort}" Margin="0,2,0,10" Padding="5"/>
                    </StackPanel>
                </UniformGrid>

                <Border Background="#EEF7FF" BorderBrush="#C7DCEF" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,15">
                    <TextBlock Text="Безопасное SMTP-подключение включено автоматически. Для порта 465 используется SSL, для других защищенных портов — STARTTLS." 
                               FontSize="11"
                               Foreground="#4A6572"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Если отправляете другому человеку, сначала загрузите его recipient_public.pem на вкладке 'КЛЮЧИ'." FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,8" TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBlock Text="* Ключи хранятся в AppData\Roaming\CryptoMail\Keys" FontSize="10" Foreground="#7F8C8D" Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
