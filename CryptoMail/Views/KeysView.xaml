<UserControl x:Class="CryptoMail.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="800">
    <Grid Background="White" >
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Управление ключами RSA" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Ваши ключи (Отправитель)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="Публичный ключ:" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBox Text="{Binding KeyPaths.SenderPublicPath}" IsReadOnly="True" Margin="0,5" FontSize="10" Background="#F9F9F9"/>
                            
                            <TextBlock Text="Отпечаток (Fingerprint):" FontSize="11" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding SenderFingerprint}" FontWeight="SemiBold" Margin="0,2,0,15" TextWrapping="Wrap" FontFamily="Consolas"/>
                            
                            <Button Content="Сгенерировать новые" Command="{Binding GenerateSenderKeysCommand}" Style="{StaticResource ModernButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Ваши ключи (Получатель)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="Публичный ключ:" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBox Text="{Binding KeyPaths.RecipientPublicPath}" IsReadOnly="True" Margin="0,5" FontSize="10" Background="#F9F9F9"/>
                            
                            <TextBlock Text="Отпечаток (Fingerprint):" FontSize="11" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding RecipientFingerprint}" FontWeight="SemiBold" Margin="0,2,0,15" TextWrapping="Wrap" FontFamily="Consolas"/>
                            
                            <Button Content="Сгенерировать новые" Command="{Binding GenerateRecipientKeysCommand}" Style="{StaticResource ModernButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,20,0,0" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="5" Background="#F8F9FA">
                    <StackPanel>
                        <TextBlock Text="Доверенные ключи отправителей" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="Если вам прислали публичный ключ для проверки подписи, добавьте его здесь." FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,15" TextWrapping="Wrap"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TrustedKeyPath}" IsReadOnly="True" Padding="8" VerticalAlignment="Center" Background="White"/>
                            <Button Grid.Column="1" Content="Добавить ключ (.pem)" Command="{Binding AddTrustedKeyCommand}" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                        
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTrustedKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Отпечаток доверенного ключа:" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBlock Text="{Binding TrustedFingerprint}" FontWeight="Bold" Foreground="#27AE60" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Открыть папку с ключами" 
                            Command="{Binding OpenKeysFolderCommand}" 
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#34495E"/>
                    
                    <Button Content="Открыть папку Output" 
                            Command="{Binding OpenOutputFolderCommand}" 
                            Margin="15,0,0,0"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#34495E"/>
                </StackPanel>
                
                <TextBlock Text="* Ключи и результаты хранятся в профиле пользователя (AppData\Roaming\CryptoMail)" 
                           Margin="0,15,0,0" FontSize="11" Foreground="#7F8C8D" FontStyle="Italic"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
