<UserControl x:Class="CryptoMail.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="KeysCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE4EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#22313F"/>
        </Style>

        <Style x:Key="CardHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#637381"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7B8794"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FileLinkButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F6FB2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"
                                   Cursor="Hand"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FingerprintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#162536"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>

        <Style x:Key="InfoPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F7FAFD"/>
            <Setter Property="BorderBrush" Value="#D8E2EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Ваши ключи"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="2,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KeysCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ключ получателя" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Передается другим людям, чтобы они могли зашифровать письмо для вас."
                                       Margin="0,5,0,10"
                                       Style="{StaticResource CardHintStyle}"/>

                            <Border Style="{StaticResource InfoPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Файл" Style="{StaticResource FieldLabelStyle}"/>
                                    <Button Content="recipient_public.pem"
                                            Command="{Binding OpenRecipientPublicFileCommand}"
                                            Style="{StaticResource FileLinkButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Отпечаток"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding RecipientFingerprint}" Style="{StaticResource FingerprintTextStyle}"/>

                            <Button Content="Сгенерировать ключи получателя"
                                    Command="{Binding GenerateRecipientKeysCommand}"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KeysCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ключ отправителя" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="По нему получатель проверяет подпись. При генерации он копируется в trusted_sender.pem."
                                       Margin="0,5,0,10"
                                       Style="{StaticResource CardHintStyle}"/>

                            <Border Style="{StaticResource InfoPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Файл" Style="{StaticResource FieldLabelStyle}"/>
                                    <Button Content="sender_public.pem"
                                            Command="{Binding OpenSenderPublicFileCommand}"
                                            Style="{StaticResource FileLinkButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Отпечаток"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding SenderFingerprint}" Style="{StaticResource FingerprintTextStyle}"/>

                            <Button Content="Сгенерировать ключи отправителя"
                                    Command="{Binding GenerateSenderKeysCommand}"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource ActionButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Ключи для обмена"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="2,0,0,10"/>

                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KeysCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Чужой ключ получателя" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Нужен только если вы отправляете письмо другому человеку."
                                       Margin="0,5,0,10"
                                       Style="{StaticResource CardHintStyle}"/>

                            <Border Style="{StaticResource InfoPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Текущий файл" Style="{StaticResource FieldLabelStyle}"/>
                                    <Button Content="partner_recipient_public.pem"
                                            Command="{Binding OpenPartnerRecipientKeyFileCommand}"
                                            Style="{StaticResource FileLinkButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Отпечаток"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding PartnerRecipientFingerprint}" Style="{StaticResource FingerprintTextStyle}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Выбрать файл"
                                        Command="{Binding AddPartnerRecipientKeyCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="Очистить"
                                        Command="{Binding ClearPartnerRecipientKeyCommand}"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KeysCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Доверенный sender_public.pem" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Используется только для проверки подписи отправителя."
                                       Margin="0,5,0,10"
                                       Style="{StaticResource CardHintStyle}"/>

                            <Border Style="{StaticResource InfoPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Текущий файл" Style="{StaticResource FieldLabelStyle}"/>
                                    <Button Content="trusted_sender.pem"
                                            Command="{Binding OpenTrustedKeyFileCommand}"
                                            Style="{StaticResource FileLinkButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Отпечаток"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding TrustedFingerprint}" Style="{StaticResource FingerprintTextStyle}"/>

                            <Button Content="Загрузить sender_public.pem"
                                    Command="{Binding AddTrustedKeyCommand}"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource KeysCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Быстрые действия" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Открыть папку с ключами или папку с расшифрованными файлами."
                                       Margin="0,5,0,0"
                                       Style="{StaticResource CardHintStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Открыть папку с ключами"
                                Command="{Binding OpenKeysFolderCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#334155"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Открыть папку Output"
                                Command="{Binding OpenOutputFolderCommand}"
                                Style="{StaticResource GhostButtonStyle}"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
