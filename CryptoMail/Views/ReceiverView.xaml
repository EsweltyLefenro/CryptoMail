<UserControl x:Class="CryptoMail.Views.ReceiverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="20">
            <TextBlock Text="Прием и расшифровка" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>
            
            <TextBlock Text="Фильтр по теме письма:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Settings.SubjectFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" Padding="8"/>

            <Border Background="#FDFEFE" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="5" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Действие:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Приложение подключится к IMAP, найдет последнее письмо с указанной темой, скачает вложение, расшифрует его и проверит цифровую подпись." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,20"/>
                    
                    <Button Content="ПОЛУЧИТЬ И РАСШИФРОВАТЬ" 
                            Command="{Binding ReceiveAndDecryptCommand}" 
                            Height="55" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>
            
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#27AE60" TextWrapping="Wrap" FontSize="14"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="20">
            <StackPanel>
                <TextBlock Text="Настройки почты (IMAP)" FontWeight="Bold" Margin="0,0,0,15" FontSize="14"/>
                
                <TextBlock Text="Ваш Email (Логин):" FontSize="11" Foreground="#7F8C8D"/>
                <TextBox Text="{Binding Settings.Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" Padding="5"/>

                <TextBlock Text="Пароль приложения:" FontSize="11" Foreground="#7F8C8D"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ReceiverPasswordBox" Padding="5" PasswordChanged="ReceiverPasswordBox_OnPasswordChanged"/>
                    <TextBox x:Name="ReceiverPasswordReveal" Padding="5" Visibility="Collapsed" Text="{Binding Settings.Password, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="👁" Width="30" Margin="5,0,0,0" 
                            PreviewMouseDown="PasswordReveal_MouseDown" 
                            PreviewMouseUp="PasswordReveal_MouseUp"
                            Style="{StaticResource GhostButtonStyle}" Padding="0"/>
                </Grid>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="IMAP Хост:" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding Settings.ImapHost}" Margin="0,2,0,10" Padding="5"/>
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Порт:" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBox Text="{Binding Settings.ImapPort}" Margin="0,2,0,10" Padding="5"/>
                    </StackPanel>
                </UniformGrid>

                <Border Background="#EEF7FF" BorderBrush="#C7DCEF" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,15">
                    <TextBlock Text="Безопасное IMAP-подключение включено автоматически. Для порта 993 используется SSL, для других защищенных портов — STARTTLS." 
                               FontSize="11"
                               Foreground="#4A6572"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="* Результаты сохраняются в AppData\Roaming\CryptoMail\Output" FontSize="10" Foreground="#7F8C8D" Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
