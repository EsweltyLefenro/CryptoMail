<UserControl x:Class="CryptoMail.Views.ReceiverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Receiver" FontSize="18" FontWeight="Bold" Margin="0 0 0 12"/>

            <TextBlock Text="IMAP host"/>
            <TextBox Text="{Binding Settings.ImapHost, UpdateSourceTrigger=PropertyChanged}" Margin="0 4 0 8"/>
            <TextBlock Text="IMAP port"/>
            <TextBox Text="{Binding Settings.ImapPort, UpdateSourceTrigger=PropertyChanged}" Margin="0 4 0 8"/>
            <TextBlock Text="Login"/>
            <TextBox Text="{Binding Settings.Login, UpdateSourceTrigger=PropertyChanged}" Margin="0 4 0 8"/>
            <TextBlock Text="Password"/>
            <PasswordBox PasswordChanged="ReceiverPasswordBox_OnPasswordChanged" Margin="0 4 0 8"/>
            <TextBlock Text="Subject filter"/>
            <TextBox Text="{Binding Settings.SubjectFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0 4 0 8"/>

            <Button Content="Receive, decrypt and verify" Command="{Binding ReceiveAndDecryptCommand}" Margin="0 8 0 8" Height="34"/>

            <TextBlock Text="Status:" FontWeight="Bold"/>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
